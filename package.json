{
  "name": "kap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "十年前端工程师知识自查交互站",
  "scripts": {
    "dev": "vite",
    "build": "run-s validate:content lint typecheck generate:sitemap build:only",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "generate:sitemap": "tsx scripts/gen-sitemap.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "echarts": "^5.5.1",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pinia": "^2.2.6",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/repl": "^4.4.2",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "npm-run-all2": "^7.0.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.4.1",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": ["eslint --fix"],
    "*.{ts,tsx,vue,css,scss,json,md}": ["prettier --write"]
  }
}
