{
  "name": "kap",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "description": "前端工程师知识自查交互站",
  "scripts": {
    "dev": "vite",
    "build": "run-s validate:content lint lint:style typecheck typecheck:node test generate:sitemap build:only",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,vue}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,css,scss,json,md}\"",
    "generate:sitemap": "tsx scripts/gen-sitemap.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "content:summary": "tsx scripts/fill-summary.ts",
    "content:summary:write": "tsx scripts/fill-summary.ts --write",
    "content:pitfall": "tsx scripts/inject-pitfall-followup.ts",
    "content:pitfall:write": "tsx scripts/inject-pitfall-followup.ts --write",
    "content:followups": "tsx scripts/generate-followup-questions.ts",
    "content:followups:write": "tsx scripts/generate-followup-questions.ts --write",
    "content:links": "tsx scripts/generate-related-links.ts",
    "content:links:write": "tsx scripts/generate-related-links.ts --write",
    "content:polish": "tsx scripts/refine-content-quality.ts",
    "content:polish:write": "tsx scripts/refine-content-quality.ts --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "dompurify": "^3.4.3",
    "echarts": "^6.0.0",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "pinia": "^2.2.6",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/ui": "^4.1.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.2",
    "npm-run-all2": "^7.0.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.8"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
